if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

define( '{{UPREFIX}}_VERSION', '{{VERSION}}' );
define( '{{UPREFIX}}_FILE', __FILE__ );
define( '{{UPREFIX}}_PATH', plugin_dir_path( __FILE__ ) );

/**
 * Load the plugin text domain.
 *
 * @return void
 */
function {{PREFIX}}_load_textdomain() {
	load_plugin_textdomain( '{{SLUG}}', false, dirname( plugin_basename( {{UPREFIX}}_FILE ) ) . '/languages' );
}
add_action( 'init', '{{PREFIX}}_load_textdomain' );

