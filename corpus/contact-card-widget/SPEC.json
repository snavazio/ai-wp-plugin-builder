  "shortcodes": [],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [
    "Contact_Card_Widget"
  ],
  "dataStorage": "widget_options",
  "securityRequirements": [
