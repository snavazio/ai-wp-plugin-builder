{
  "slug": "sponsors-api",
  "pluginName": "Sponsors API",
  "description": "A Sponsor CPT with a secure website meta box and a public REST endpoint for published sponsors.",
  "version": "1.0.0",
  "prefix": "spns",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [],
  "postTypes": [
    "sponsor"
  ],
  "taxonomies": [],
  "adminPages": [],
  "shortcodes": [],
  "blocks": [],
  "restEndpoints": [
    "/wp/v2/sponsors"
  ],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_meta",
  "securityRequirements": [
    "wp_verify_nonce(...)",
    "current_user_can(...)",
    "esc_html()",
    "sanitize_text_field()"
  ],
  "smokeAssertions": [
    "post_type_exists('sponsor')"
  ]
}
