{
  "slug": "ajax-contact-form",
  "pluginName": "AJAX Contact Form",
  "description": "A contact form shortcode with AJAX submission, storing submissions as private CPT",
  "version": "1.0.0",
  "prefix": "acff",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [],
  "postTypes": [
    {
      "name": "submission",
      "public": false
    }
  ],
  "taxonomies": [],
  "adminPages": [],
  "shortcodes": [
    {
      "name": "contact_form"
    }
  ],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [
    "contact_form_submit"
  ],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_type",
  "securityRequirements": [
    "wp_verify_nonce( $_POST['nonce'], 'contact_form_nonce' )",
    "current_user_can( 'edit_posts' )"
  ],
  "smokeAssertions": [
    "shortcode_exists('contact_form')",
    "post_type_exists('submission')",
    "has_action('wp_ajax_contact_form_submit')"
  ]
}
