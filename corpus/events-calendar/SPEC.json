{
  "slug": "events-calendar",
  "pluginName": "Events Calendar",
  "description": "Event CPT with start-date and location meta, admin Start Date column, and [events] shortcode for upcoming events. All output escaped, input sanitized, with nonce and capability checks.",
  "version": "1.0.0",
  "prefix": "evcal",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [],
  "postTypes": [
    "event"
  ],
  "taxonomies": [],
  "adminPages": [],
  "shortcodes": [
    "events"
  ],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_meta",
  "securityRequirements": [
    "wp_verify_nonce( $_POST['nonce'], 'action' ) === true",
    "current_user_can( 'edit_posts' )"
  ],
  "smokeAssertions": [
    "post_type_exists('event')",
    "shortcode_exists('events')"
  ]
}
