{
  "slug": "book-library",
  "pluginName": "Book Library",
  "description": "A plugin for managing books with custom post types, taxonomies, and a shortcode for displaying library content.",
  "version": "1.0.0",
  "prefix": "blib",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [],
  "postTypes": [
    "book"
  ],
  "taxonomies": [
    "author",
    "genre"
  ],
  "adminPages": [],
  "shortcodes": [
    "library"
  ],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_meta",
  "securityRequirements": [
    "post_type_exists('book')",
    "taxonomy_exists('author')",
    "taxonomy_exists('genre')",
    "shortcode_exists('library')"
  ],
  "smokeAssertions": []
}
