    "region"
  ],
  "adminPages": [],
  "shortcodes": [
    "listings"
  ],
  "blocks": [],
  "restEndpoints": [
    "listings"
  ],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_type, taxonomy",
  "securityRequirements": [
    "esc_html(...)",
    "sanitize_text_field(...)",
    "wp_verify_nonce(...)",
    "current_user_can(...)"
  ],
  "smokeAssertions": [
    "post_type_exists('listing')",
