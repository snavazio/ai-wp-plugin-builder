{
  "slug": "products-catalog",
  "pluginName": "Products Catalog",
  "description": "A catalog of products with hierarchical categories and a shortcode for listing.",
  "version": "1.0.0",
  "prefix": "prod",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [
    "manage_options"
  ],
  "postTypes": [
    "product"
  ],
  "taxonomies": [
    "product_category"
  ],
  "adminPages": [],
  "shortcodes": [
    "products"
  ],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_types_and_taxonomies",
  "securityRequirements": [
    "wp_verify_nonce( $_POST['nonce'], 'product_action' )",
    "current_user_can( 'manage_options' )"
  ],
  "smokeAssertions": [
    "post_type_exists( 'product' )",
    "taxonomy_exists( 'product_category' )",
    "shortcode_exists( 'products' )"
  ]
}
