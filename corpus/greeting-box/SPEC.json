{
  "slug": "greeting-box",
  "pluginName": "Greeting Box",
  "description": "A very small plugin that provides a single shortcode [greeting_box] for the front end.",
  "version": "1.0.0",
  "prefix": "gbox",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [],
  "postTypes": [],
  "taxonomies": [],
  "adminPages": [],
  "shortcodes": [
    "greeting_box"
  ],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": null,
  "securityRequirements": [
    "esc_html()",
    "sanitize_text_field()"
  ],
  "smokeAssertions": [
    "shortcode_exists('greeting_box')",
    "function_exists('gbox_greeting_box_shortcode')",
    "defined('GBOX_VERSION')"
  ]
