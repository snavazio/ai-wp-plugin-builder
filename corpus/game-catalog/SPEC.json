{
  "slug": "game-catalog",
  "pluginName": "Game Catalog",
  "description": "A custom post type for games with release year, platform, and genre taxonomies, plus a shortcode.",
  "version": "1.0.0",
  "prefix": "gcat",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [],
  "postTypes": [
    "game"
  ],
  "taxonomies": [
    "platform",
    "genre"
  ],
  "adminPages": [],
  "shortcodes": [
    "games"
  ],
  "blocks": [],
  "restEndpoints": [],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": "post_meta",
  "securityRequirements": [],
  "smokeAssertions": [
    "post_type_exists('game')",
    "taxonomy_exists('platform')",
    "taxonomy_exists('genre')",
    "shortcode_exists('games')"
  ]
}
