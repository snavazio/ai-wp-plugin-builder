{
  "slug": "artworks-api",
  "pluginName": "Artworks API",
  "description": "Custom post type for artworks with artist metadata and public REST API endpoint",
  "version": "1.0.0",
  "prefix": "artw",
  "requiresWp": "6.0",
  "requiresPhp": "7.4",
  "capabilities": [
    "edit_posts"
  ],
  "postTypes": [
    "artwork"
  ],
  "taxonomies": [],
  "adminPages": [],
  "shortcodes": [],
  "blocks": [],
  "restEndpoints": [
    "artworks"
  ],
  "ajaxActions": [],
  "cronEvents": [],
  "widgets": [],
  "dataStorage": [
    "artist"
  ],
  "securityRequirements": [
    "isset($_POST['artwork_nonce']) && wp_verify_nonce($_POST['artwork_nonce'], 'artwork_meta_box_nonce')",
    "current_user_can('edit_posts')"
  ],
  "smokeAssertions": [
    "post_type_exists('artwork')"
  ]
}
