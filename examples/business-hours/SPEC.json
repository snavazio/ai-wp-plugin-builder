      "attributes": []
    }
  ],
  "blocks": [],
  "restEndpoints": [],
  "dataStorage": "Settings stored in wp_options table using WordPress Settings API with prefixed option keys (bhrs_monday_open, bhrs_monday_close, bhrs_monday_closed, etc. for all seven days).",
  "securityRequirements": [
    "Escape all output with esc_html(), esc_attr(), or wp_kses_post() as appropriate",
    "Nonce verification via Settings API built-in protection or explicit check_admin_referer() with capability check for manage_options",
    "Sanitize all input with sanitize_text_field() for time text inputs and rest_sanitize_boolean() or checkbox validation for closed checkboxes",
    "ABSPATH guard at top of every PHP file",
    "Use get_option() and update_option() core APIs exclusively"
  ],
  "smokeAssertions": [
    "shortcode_exists('business_hours')",
    "false !== get_option('bhrs_monday_open', false) || false !== get_option('bhrs_monday_closed', false)",
    "has_action('admin_menu', 'bhrs_add_settings_page') !== false || function_exists('bhrs_add_settings_page')",
    "has_action('admin_init', 'bhrs_register_settings') !== false || function_exists('bhrs_register_settings')"
  ]
